# PostgreSQL (Docker Compose)
POSTGRES_USER=scouts_user
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=scouts_db
POSTGRES_PORT=5432

# Backend NestJS
BACKEND_PORT=3000
DATABASE_URL=postgresql://scouts_user:change-this-to-a-long-random-password@db:5432/scouts_db?schema=public
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_IDLE_MS=900000
SESSION_MAX_MS=28800000

# Frontend Vite
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# Initial administrator.
# Used only when running the one-time bootstrap command.
ADMIN_EMAIL=admin@example.org
ADMIN_NAME=Administrador
ADMIN_PASSWORD=replace-with-a-long-password-of-at-least-15-characters
