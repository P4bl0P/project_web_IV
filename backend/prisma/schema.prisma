generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING   // Paso 2: Solicitud recibida pendiente de revisar por el Consejo
  WAITLIST  // Paso 3: Revisada y apuntada en la lista de espera
  ADMITTED  // Paso 4: Plaza asignada, enviada inscripción y pasado al Censo
  REJECTED  // Solicitud descartada o baja de la lista
}

enum ScoutBranch {
  CASTOR    // 6-8 años (Colonia)
  LOBATO    // 8-11 años (Manada)
  RANGER    // 11-14 años (Tropa)
  PIONERO   // 14-17 años (Posta)
  RUTA      // 17-20 años (Clan)
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  status            ApplicationStatus @default(PENDING)
  requestDate       DateTime          @default(now())
  requestedBranch   ScoutBranch

  // Datos del niño/a (educando)
  childName         String            @db.VarChar(150)
  childBirthDate    DateTime          @db.Date
  address           String            @db.VarChar(255)

  // Datos de los padres / tutores
  fatherName        String?           @db.VarChar(150)
  fatherPhone       String?           @db.VarChar(30)
  fatherEmail       String?           @db.VarChar(150)

  motherName        String?           @db.VarChar(150)
  motherPhone       String?           @db.VarChar(30)
  motherEmail       String?           @db.VarChar(150)

  // Motivación y notas del Consejo
  motivation        String            @db.Text
  councilNotes      String?           @db.Text

  // Criterios de baremación en lista de espera
  hasFamilyInGroup  Boolean           @default(false)
  fromAnotherGroup  Boolean           @default(false)
  socialInclusion   Boolean           @default(false)

  // Relación 1:1 cuando pasa al Censo (Paso 4)
  censusMember      Member?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Índices justificados por consultas de lista de espera y filtrado por rama
  @@index([status, requestedBranch, requestDate])
}

model Member {
  id              String       @id @default(uuid()) @db.Uuid
  fullName        String       @db.VarChar(150)
  birthDate       DateTime     @db.Date
  currentBranch   ScoutBranch
  address         String       @db.VarChar(255)
  primaryPhone    String       @db.VarChar(30)
  primaryEmail    String       @db.VarChar(150)
  enrollmentDate  DateTime     @default(now())
  isActive        Boolean      @default(true)

  applicationId   String?      @unique @db.Uuid
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([currentBranch, isActive])
}