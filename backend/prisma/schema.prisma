generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Estados del flujo completo (Solicitud -> Lista de Espera -> Inscripción -> Censo)
enum ApplicationStatus {
  PENDIENTE_REVISION // Acaba de enviar el formulario inicial (Fase 1)
  LISTA_ESPERA // Revisado por el Kraal, esperando hueco en su rama
  PLAZA_OFERTADA // Enlace mágico activo enviado a los padres (Fase 2)
  INSCRIPCION_COMPLETADA // Padres rellenaron y firmaron Fase 2; falta revisión/alta en censo
  CENSADO // Miembro oficial activo del Grupo IV
  BAJA // Cierre estructurado (retirada, rechazada, baja voluntaria, etc.)
}

// Motivos estructurados de cierre o baja para eliminar la ambigüedad de BAJA
enum ClosureReason {
  SOLICITUD_RETIRADA
  SOLICITUD_RECHAZADA
  OFERTA_RECHAZADA
  OFERTA_CADUCADA
  BAJA_VOLUNTARIA
  BAJA_DISCIPLINARIA
  BAJA_POR_EDAD
  DUPLICADO
  OTRO
}

// 2. Sexo/Género (Recogido en Inscripción/Censo; Aurora admite MALE / FEMALE)
enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

// 3. Situación legal del asociado (Hoja 1 MSC)
enum LegalStatus {
  MENOR
  MAYOR
  EMANCIPADO
}

// 4. Tipo de custodia (Hoja 1 MSC - Determina si exige 1 o 2 firmas)
enum CustodyType {
  SIN_ESPECIFICAR
  TUTELA_LEGAL
  CUSTODIA_UNICA
  CUSTODIA_CONJUNTA
}

// 5. Preferencia de recepción de circulares (Hoja 1 MSC)
enum CircularPreference {
  EMAIL
  CORREO_POSTAL
}

// ============================================================================
// MODELO PRINCIPAL: Solicitud, Lista de Espera, Oferta, Ciclo de Vida y Censo
// ============================================================================
model Applicant {
  id        String            @id @default(uuid())
  createdAt DateTime          @default(now()) // Fecha oficial de solicitud (criterio de orden)
  updatedAt DateTime          @updatedAt
  status    ApplicationStatus @default(PENDIENTE_REVISION)

  // --- DATOS DEL EDUCANDO (Fase 1 -> reutilizados y ampliados en Fase 2) ---
  childFirstName                String
  childLastName1                String
  childLastName2                String?
  hasNoSecondLastName           Boolean  @default(false)
  noSecondLastNameJustification String?
  childLastName                 String // Nombre completo de apellidos sincronizado
  childBirthDate                DateTime
  gender                        Gender? // Se recoge en Inscripción (Fase 2), nulo en Solicitud (Fase 1)

  // --- DIRECCIÓN POSTAL DESGLOSADA (Exclusiva de Fase 2 / Censo, nula en Fase 1) ---
  streetAddress String?
  streetNumber  String?
  apartmentDoor String? @map("apartmentDoor") // Piso / Puerta (normalizado desde ApartmentDoor)
  postalCode    String?
  municipality  String?
  province      String?

  // --- UNIDAD FAMILIAR Y TUTORES (Fase 1 -> ampliados en Fase 2) ---
  familyUnitId        String?
  parent1FirstName    String
  parent1LastName     String
  parent1Phone        String
  parent1Email        String
  parent1Relationship String?

  // --- SEGUNDO TUTOR OPCIONAL ---
  parent2FirstName    String?
  parent2LastName     String?
  parent2Phone        String?
  parent2Email        String?
  parent2Relationship String?

  // --- MOTIVACIÓN Y CRITERIOS DE ADMISIÓN ---
  motivation              String? @db.Text
  hasFamilyInGroup        Boolean @default(false) // Prioridad: Familiar en el grupo (+100)
  familyMemberDetails     String?
  comesFromOtherGroup     Boolean @default(false) // Prioridad: Viene de otro grupo scout (+25)
  originGroupDetails      String?
  socialInclusionPriority Boolean @default(false) // Prioridad: Inclusión (+50)
  kraalInternalNotes      String? @db.Text // Notas privadas del Kraal

  // --- CONTROL DEL ENLACE MÁGICO (Un solo uso y expiración verificada) ---
  enrollmentToken     String?   @unique // Token cifrado en reposo mientras está activo
  enrollmentTokenHash String?   @unique // Hash SHA-256 para búsqueda segura
  tokenExpiresAt      DateTime?
  tokenUsedAt         DateTime?

  // --- REVISIÓN, ALTA EN CENSO Y BAJA TRAZABLE ---
  reviewedAt       DateTime?
  reviewedById     String?
  admittedAt       DateTime? // Exclusivamente fecha efectiva de alta en el censo oficial (Aurora startAt)
  admittedById     String?
  censusSolarRound String? // Ronda solar asignada al censar (ej. "2026/2027")
  censusBranch     String? // Rama asignada al censar (conserva el historial)

  closedAt       DateTime?
  closedById     String?
  closureReason  ClosureReason?
  closureNotes   String?            @db.Text
  previousStatus ApplicationStatus?

  idempotencyKey String? @unique // Control de idempotencia en reintentos

  // --- RELACIÓN 1:1 CON DATOS DE INSCRIPCIÓN OFICIAL ---
  enrollment EnrollmentDetails?

  @@index([status])
  @@index([status, createdAt])
  @@index([childBirthDate])
  @@index([familyUnitId])
  @@index([parent1Email])
  @@index([parent1Phone])
}

// ============================================================================
// MODELO FASE 2: Hoja de Inscripción Oficial, Ficha Médica y SEPA
// ============================================================================
model EnrollmentDetails {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicantId String    @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  // --- AMPLIACIÓN HOJA 1: DATOS LEGALES Y DNI ---
  childDni           String? // DNI cifrado del educando (opcional)
  childDniHash       String?            @unique // Hash determinista para unicidad (NULL permitido múltiples veces)
  childPhone         String?
  childEmail         String?
  legalStatus        LegalStatus        @default(MENOR)
  circularPreference CircularPreference @default(EMAIL)

  parent1Dni           String // Cifrado en reposo
  parent2Dni           String? // Cifrado en reposo (obligatorio si custodia conjunta)
  parentsMaritalStatus String?
  custodyType          CustodyType @default(SIN_ESPECIFICAR)

  // --- CONSENTIMIENTOS TRAZABLES (Hoja 1) ---
  acceptsDataStorage  Boolean @default(true)
  acceptsDataTransfer Boolean @default(true)
  authorizesImages    Boolean @default(true)
  consentTextVersion  String  @default("2026.1")

  // --- HOJA 2: FICHA MÉDICA ESTRUCTURADA (Acceso restringido + Cifrado en reposo) ---
  bloodType                    String?
  chronicDiseases              String? @db.Text
  allergies                    String? @db.Text
  medHeadache                  String?
  medFever                     String?
  medStomach                   String?
  medThroat                    String?
  medicalObservations          String? @db.Text
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  authorizesEmergency          Boolean @default(true)

  // --- HOJA 3: DOMICILIACIÓN BANCARIA (SEPA) ---
  accountHolderName         String
  accountHolderDni          String
  accountHolderAddress      String?
  accountHolderMunicipality String?
  accountHolderPostalCode   String?
  iban                      String // IBAN cifrado en reposo
  ibanLast4                 String? // Últimos 4 dígitos para mostrar enmascarado en listados
  authorizesSepa            Boolean   @default(true)
  sepaSignedAt              DateTime?

  // --- FIRMAS DIGITALES E IDENTIDAD DEL FIRMANTE ---
  signer1FullName  String?
  signer1Dni       String?
  signatureParent1 String    @db.Text // Cifrado en reposo
  signedAtParent1  DateTime  @default(now())
  signer2FullName  String?
  signer2Dni       String?
  signatureParent2 String?   @db.Text // Cifrado en reposo
  signedAtParent2  DateTime?
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
  DISABLED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String
  passwordHash       String
  status             UserStatus     @default(INVITED)
  isSuperAdmin       Boolean        @default(false)
  mustChangePassword Boolean        @default(false)
  mfaSecret          String?
  mfaConfiguredAt    DateTime?
  roleId             String?
  role               Role?          @relation(fields: [roleId], references: [id])
  sessions           Session[]
  invitations        Invitation[]
  recoveryCodes      RecoveryCode[]
  auditEvents        AuditEvent[]   @relation("Actor")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())
}

model Module {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions Permission[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id        String  @id @default(uuid())
  roleId    String
  moduleId  String
  canRead   Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

model Invitation {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
}

model RecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  result    String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([resource])
}

// ============================================================================
// MODELO CONSEJO DE GRUPO: Gestión pública de Conócenos desde Secretaría
// ============================================================================
model CouncilMember {
  id           String   @id @default(uuid())
  fullName     String
  role         String
  personalBio  String?  @db.Text
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([role])
}
